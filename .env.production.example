# Cloud Run deployment settings (Makefile reads this file)
PROJECT_ID=your-project-id
REGION=asia-northeast1
SERVICE=dinner-system-front

# Runtime env
FIRESTORE_DATABASE_ID=(default)

# Build-time public key for Next.js bundle
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# Secret Manager references (<secret-name>:<version>)
FIREBASE_PROJECT_ID_SECRET=FIREBASE_PROJECT_ID:latest
FIREBASE_CLIENT_EMAIL_SECRET=FIREBASE_CLIENT_EMAIL:latest
FIREBASE_PRIVATE_KEY_SECRET=FIREBASE_PRIVATE_KEY:latest
